APP_ENV=development
# Set a unique random value before enabling authentication or deploying.
SECRET_KEY=
# Required for authentication and academic data APIs. Use PostgreSQL.
DATABASE_URL=
# Required only for the local synthetic seed command; never use a demo password outside development.
DEMO_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_SECONDS=1
WS_HEARTBEAT_SECONDS=25
WS_MAX_CONNECTIONS=300
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
API_MAX_PAGE_SIZE=100
API_MAX_CONTENT_LENGTH=1048576
AUTH_SESSION_LIFETIME_SECONDS=28800
WEBSOCKET_ALLOWED_ORIGINS=
